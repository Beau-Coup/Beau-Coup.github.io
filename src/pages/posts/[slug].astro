---
import Layout from "../../layouts/Layout.astro";
import { render, type CollectionEntry } from "astro:content";
import { getPosts } from "../../lib/posts";
import { fmtDate } from "../../data/site";
import Proposition from "../../components/Proposition.astro";
import Definition from "../../components/Definition.astro";
import Note from "../../components/Note.astro";
import Example from "../../components/Example.astro";
import Proof from "../../components/Proof.astro";

export async function getStaticPaths() {
  const entries = await getPosts();
  return entries.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

interface Props {
  entry: CollectionEntry<"blog">;
}
const { entry } = Astro.props;
const { Content } = await render(entry);
const post = entry.data;
---

<Layout title={`${post.title} — Alex Beaudin`}>
  <article class="post">
    <a class="ulink quiet back" href="/writing">← All writing</a>
    <p class="eyebrow">{fmtDate(post.date)}</p>
    <h1 class="display">{post.title}</h1>
    {post.draft && <p class="meta"><span class="pill">Draft</span> Not published. Only visible in dev.</p>}
    <div class="prose">
        <Content components={{ Proposition, Definition, Note, Example, Proof }} />
    </div>
  </article>
</Layout>
