---
import Layout from "../layouts/Layout.astro";
import { Image } from "astro:assets";
import headshot from "../assets/headshot.jpeg";
import PostRow from "../components/PostRow.astro";
import PubList from "../components/PubList.astro";
import { PROFILE, READING, PUBLICATIONS } from "../data/site";
import { getPosts } from "../lib/posts";

const posts = (await getPosts())
  .sort((a, b) => b.data.date.localeCompare(a.data.date));
const recent = posts.slice(0, 3);
const recentPubs = [...PUBLICATIONS].sort((a, b) => b.year - a.year).slice(0, 4);
---

<Layout>
  <section class="hero">
    <div class="hero-grid">
      <div class="body">
        <p class="eyebrow sage">{PROFILE.role}</p>
        <p class="lead">{PROFILE.blurb}</p>
        <p class="lead-sub">{PROFILE.longer}</p>
        <div class="hero-links">
          {PROFILE.links.map((l) => (
            <a href={l.href}>{l.label} <span class="arrow">↗</span></a>
          ))}
        </div>
      </div>
      <div class="hero-portrait">
        <Image src={headshot} alt="Headshot" class="frame" width={320} height={400} loading="eager" />
      </div>
    </div>
  </section>

  <section class="block">
    <div class="block-head">
      <p class="eyebrow clay">Recent publications</p>
    </div>
    <PubList publications={recentPubs} />
  </section>

</Layout>
