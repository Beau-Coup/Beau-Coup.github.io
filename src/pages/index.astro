---
import Layout from "../layouts/Layout.astro";
import PostRow from "../components/PostRow.astro";
import { PROFILE, READING } from "../data/site";
import { getCollection } from "astro:content";

const posts = (await getCollection("blog"))
  .sort((a, b) => b.data.date.localeCompare(a.data.date));
const recent = posts.slice(0, 3);
---

<Layout>
  <section class="hero">
    <p class="eyebrow">{PROFILE.role}</p>
    <h1 class="display">{PROFILE.blurb}</h1>
    <p class="lede">{PROFILE.longer}</p>
    <p class="meta">
        {PROFILE.affil} · {PROFILE.email}
    </p>
    <div class="links-row">
      {PROFILE.links.map((l) => (
        <a class="ulink" href={l.href}>
          {l.label} <span class="arrow">↗</span>
        </a>
      ))}
    </div>
  </section>

  <hr class="rule" />

  <section class="block">
    <div class="block-head">
      <h2 class="h2">Recent writing</h2>
      <a class="ulink quiet" href="/writing">All entries <span class="arrow">→</span></a>
    </div>
    <ul class="post-list">
      {recent.map((p) => (
        <PostRow
          slug={p.id}
          date={p.data.date}
          title={p.data.title}
          rating={p.data.rating}
        />
      ))}
    </ul>
  </section>

  <hr class="rule" />

  <section class="block two-col">
    <div>
      <h2 class="h2">Now reading</h2>
      <ul class="reading-list">
        {READING.map((b) => (
          <li class="reading-item">
            <span class="reading-title">{b.title}</span>
            <span class="reading-author"> — {b.author}</span>
            <span class="reading-state">{b.state}</span>
          </li>
        ))}
      </ul>
    </div>
    <div>
      <h2 class="h2">Tracking</h2>
      <p class="muted">
        For some topics I keep a record of how confused I am over time. It helps
        me see progress when day-to-day it feels like none.
      </p>
      <a class="ulink" href="/tracker">Open the tracker <span class="arrow">→</span></a>
    </div>
  </section>
</Layout>
