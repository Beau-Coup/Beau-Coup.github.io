---
import katex from "katex";
import { slugify } from "../lib/glossary";

interface Props {
  type?: string;
  term?: string;
}
const { type, term } = Astro.props;
const type_name = type ?? "Proposition";
const id = term ? slugify(term) : undefined;
---
<aside id={id} class={`proposition propo-${type_name}`}>
  <p class="proposition-label">
    <span class="proposition-tag">{type_name}.</span>
        {term && <em class="proposition-term">{term}</em>}
  </p>
  <div class="proposition-body"><slot /></div>
</aside>
