---
import { PROFILE } from "../data/site";

const items = [
  { id: "home", label: "Home", href: "/", hideSm: false },
  { id: "writing", label: "Writing", href: "/writing", hideSm: false },
  { id: "glossary", label: "Glossary", href: "/glossary", hideSm: true },
  { id: "publications", label: "Publications", href: "/publications", hideSm: false },
  { id: "tracker", label: "Tracker", href: "/tracker", hideSm: true },
  { id: "projects", label: "Projects", href: "/projects", hideSm: true },
];

const path = Astro.url.pathname.replace(/\/+$/, "") || "/";
const isActive = (href: string) => {
  if (href === "/") return path === "/";
  if (href === "/writing") return path === "/writing" || path.startsWith("/posts");
  return path === href || path.startsWith(href + "/");
};
---

<header class="masthead">
  <div class="masthead-inner">
    <a class="brand" href="/" aria-label="Home">
      <img src="/leaf-mark.png" alt="" />
      <span class="name">{PROFILE.name}</span>
    </a>
    <nav>
      {items.map((it) => (
        <a
          class={"nav-link" + (isActive(it.href) ? " is-active" : "") + (it.hideSm ? " hide-sm" : "")}
          href={it.href}
        >
          {it.label}
        </a>
      ))}
    </nav>
  </div>
</header>

<script>
  const m = document.querySelector(".masthead");
  if (m) {
    const onScroll = () => m.classList.toggle("scrolled", window.scrollY > 8);
    onScroll();
    window.addEventListener("scroll", onScroll, { passive: true });
  }
</script>
