---
import "../styles/site.css";
import "katex/dist/katex.min.css";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import { Font } from "astro:assets";

interface Props {
  title?: string;
}
const { title = "Alex Beaudin — personal site" } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <link rel="icon" href="/favicon.png" />
    <meta name="generator" content={Astro.generator} />
    <Font cssVariable="--font-newsreader" preload={[{ subset: "latin" }]} />
    <Font cssVariable="--font-plex-sans" preload={[{ weight: 400, subset: "latin" }]} />
    <Font cssVariable="--font-plex-mono" />
    <title>{title}</title>
  </head>
  <body class="site site-paper">
    <Nav />
    <main class="col">
      <slot />
    </main>
    <Footer />
  </body>
</html>

<style is:global>
  * { box-sizing: border-box; }
  /* Scale the root down ~2pt: the 1.125rem body (18px) becomes 16px, and all
     other rem-based sizes shrink proportionally. Percentage (not px) keeps the
     user's browser font-size preference intact. */
  html { font-size: 88.9%; }
  html,
  body {
    margin: 0;
    width: 100%;
    min-height: 100%;
  }
</style>
